{
  "family": "xclone",
  "executionRoleArn": "arn:aws:iam::575357958164:role/xCloneEcsTaskExecRole",
  "taskRoleArn": "arn:aws:iam::575357958164:role/xCloneEcsTaskRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [ "FARGATE" ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "xclone",
      "image": "575357958164.dkr.ecr.ap-northeast-1.amazonaws.com/xclone",
      "essential": true,
      "memory": 384,
      "memoryReservation": 128,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RAILS_ENV",
          "value": "production"
        },
        {
          "name": "AWS_BUCKET",
          "value": "aws-training-shu"
        },
        {
          "name": "RAILS_SERVE_STATIC_FILES",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY_BASE",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:575357958164:secret:xclone-secret-FtHmUa:SECRET_KEY_BASE::"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:575357958164:secret:xclone-secret-FtHmUa:DB_HOST::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:575357958164:secret:xclone-secret-FtHmUa:DB_NAME::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:575357958164:secret:xclone-secret-FtHmUa:DB_USER::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:575357958164:secret:xclone-secret-FtHmUa:DB_PASSWORD::"
        }
      ],
      "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/xclone",
        "mode": "non-blocking",
        "awslogs-create-group": "true",
        "max-buffer-size": "25m",
        "awslogs-region": "ap-northeast-1",
        "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      }
    }
  ]
}