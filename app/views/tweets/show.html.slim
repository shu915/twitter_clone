.l-inner
  = render partial: 'shared/sidebar'

  .p-tweet-detail__content
    h2.p-tweet-detail__title ツイート詳細

    = render partial: 'shared/tweet', locals: { tweet: @tweet}

    .p-tweet-detail__reply-container
      .p-tweet-detail__reply-avatar 
        = image_tag current_user.avatar
      = form_with model: @reply ,url: tweet_reply_create_path(@tweet) , class: 'p-tweet-detail__reply-form' do |form|
        = form.text_area :content, class: 'p-tweet-detail__reply-area', placeholder: '返信をツイート'
        = render partial: 'shared/validation_error', locals: { object: @reply ,field: :content }

        .p-tweet-detail__reply-footer
          .p-tweet_detail__reply-form-group
            = form.label :image, '画像を選択', class: 'p-tweet-detail__reply-label'
            = form.file_field :image, class: 'p-tweet_detail__reply-input'
            = render partial: 'shared/validation_error', locals: { object: @reply ,field: :image }

          = form.submit '返信', class: 'c-button p-tweet-detail__reply-button'
    
    .p-tweet-detail__reply-list
      - @replies.each do |reply|
        - unless reply == @reply
          = render partial: 'shared/tweet', locals: { tweet: reply }

    - if @replies.present? && @replies.count > 10
      .p-tweet-detail__page
        = paginate @replies
