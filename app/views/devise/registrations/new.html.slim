.p-devise__inner

  h2.p-devise__title
    | twitter_cloneに登録する
  = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
    = render "devise/shared/error_messages", resource: resource
    .p-devise__form-group
      = f.label :email, class: 'p-devise__form-label'
      = f.email_field :email, autofocus: true, autocomplete: "Eメール(必須)", class: 'p-devise__form-input', placeholder: 'exmaple@exmaple.com'
    .p-devise__form-group
      = f.label :tel, '電話番号(必須)', class: 'p-devise__form-label'
      = f.text_field :tel, class: 'p-devise__form-input', placeholder: '07011112222'
    .p-devise__form-group
      = f.label :birthday, '誕生日(必須)', class: 'p-devise__form-label'
      = f.text_field :birthday, class: 'p-devise__form-input', placeholder: '2000-04-01'
    .p-devise__form-group
      = f.label :password, class: 'p-devise__form-label'
      = f.password_field :password, autocomplete: "new-password", class: 'p-devise__form-input'
    .p-devise__form-group
      = f.label :password_confirmation, class: 'p-devise__form-label'
      = f.password_field :password_confirmation, autocomplete: "new-password", class: 'p-devise__form-input'
    .p-devise__form-actions
      = f.submit "登録する" ,class: 'c-button p-devise__button'
  = render "devise/shared/links"
