.p-devise__inner

  h2.p-devise__title
    | twitter_cloneに登録する
  = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
    / = render "devise/shared/error_messages", resource: resource
    .p-devise__form-group
      = f.label :email, class: 'p-devise__form-label'
      = f.email_field :email, autofocus: true, autocomplete: "Eメール(必須)", class: 'p-devise__form-input', placeholder: 'exmaple@exmaple.com'
      = render partial: 'shared/validation_error', locals: { object: resource, field: :email }
    .p-devise__form-group
      = f.label :account_name, 'アカウントネーム', class: 'p-devise__form-label'
      = f.text_field :account_name, class: 'p-devise__form-input', placeholder: 'bob123'
      = render partial: 'shared/validation_error', locals: { object: resource, field: :account_name }
    .p-devise__form-group
      = f.label :display_name, 'ディスプレイネーム', class: 'p-devise__form-label'
      = f.text_field :display_name, class: 'p-devise__form-input', placeholder: 'ボブ'
      = render partial: 'shared/validation_error', locals: { object: resource, field: :display_name }
    .p-devise__form-group
      = f.label :tel, '電話番号(必須)', class: 'p-devise__form-label'
      = f.text_field :tel, class: 'p-devise__form-input', placeholder: '07011112222'
      = render partial: 'shared/validation_error', locals: { object: resource, field: :tel }
    .p-devise__form-group
      = f.label :birthday, '誕生日(必須)', class: 'p-devise__form-label'
      = f.text_field :birthday, class: 'p-devise__form-input', placeholder: '2000-04-01'
      = render partial: 'shared/validation_error', locals: { object: resource, field: :birthday }
    .p-devise__form-group
      = f.label :password, class: 'p-devise__form-label'
      = f.password_field :password, autocomplete: "new-password", class: 'p-devise__form-input'
      = render partial: 'shared/validation_error', locals: { object: resource, field: :password }
    .p-devise__form-group
      = f.label :password_confirmation, class: 'p-devise__form-label'
      = f.password_field :password_confirmation, autocomplete: "new-password", class: 'p-devise__form-input'
      = render partial: 'shared/validation_error', locals: { object: resource, field: :password_confirmation }
    .p-devise__form-actions
      = f.submit "登録する" ,class: 'c-button p-devise__button'
  = render "devise/shared/links"
