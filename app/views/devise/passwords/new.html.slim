.p-devise__inner
  h2.p-devise__title
    | パスワードをリセット
  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
    .p-devise__form-group
      = f.label :email, class: 'p-devise__form-label'
      = f.email_field :email, autofocus: true, autocomplete: "email", class: 'p-devise__form-input', placeholder: 'user1@example.com'
      = render partial: 'shared/validation_error', locals: { object: resource , field: :email }
    .p-devise__form-actions
      = f.submit "パスワードをリセット", class: 'c-button p-devise__form-button'
  = render "devise/shared/links"
